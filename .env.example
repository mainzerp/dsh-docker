# --- DeepSeek Harness ---
# API key for DeepSeek (model + web search).
# Alternative: $DSH_HOME/.env or $DSH_HOME/.credentials.yaml in the /data volume.
DEEPSEEK_API_KEY=

# Optional: OpenAI-compatible proxy endpoint, model override, system prompt
# (dsh config env vars; see docs/config-catalog.md in the dsh repo)
#DEEPSEEK_BASE_URL=
#DSH_MODEL=
#DSH_SYSTEM_PROMPT=

# --- Additional model providers (optional) ---
# Providers are configured in the Web UI (Settings -> Models) and persist in
# /data/.credentials.yaml. Uncomment only if a provider entry references the
# variable via apiKeyEnv.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# --- WebUI / LAN access ---
# Comma-separated authorities (host:port) used to reach the WebUI.
# Required because the /api trust fence rejects unknown Host headers.
# Example: TRUSTED_HOSTS=192.168.1.10:3080,myserver:3080
TRUSTED_HOSTS=

# --- GitHub ---
# Token for gh/git (https://github.com/settings/tokens). Durable alternative
# to `gh auth login` (whose state lives in the container layer and is lost
# on container recreation).
GH_TOKEN=

# Git identity for commits (git reads these variables automatically).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# --- Build (only relevant for `docker compose build` / `up --build`) ---
# Pin the dsh version, e.g. 0.1.0-rc.7 (empty = latest)
DSH_VERSION=
# Pin the GitHub CLI version (empty = Dockerfile default)
GH_VERSION=
# Pin the Playwright version for browser tooling (empty = Dockerfile default)
PLAYWRIGHT_VERSION=
# Pin the uv version (empty = Dockerfile default)
UV_VERSION=
