# --- DeepSeek Harness ---
# API key for DeepSeek (model + web search).
# Alternative: $DSH_HOME/.env or $DSH_HOME/.credentials.yaml in the /data volume.
DEEPSEEK_API_KEY=

# Optional: OpenAI-compatible proxy endpoint, model override, system prompt
# (dsh config env vars; see docs/config-catalog.md in the dsh repo)
#DEEPSEEK_BASE_URL=
#DSH_MODEL=
#DSH_SYSTEM_PROMPT=

# --- Additional model providers (optional) ---
# Providers are configured in the Web UI (Settings -> Models) and persist in
# /data/.credentials.yaml. Uncomment only if a provider entry references the
# variable via apiKeyEnv.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# --- WebUI / LAN access ---
# Since 0.1.2 the WebUI requires a per-launch token: after `up`, get the
# authenticated URL from the container logs and open a "dsh web (external):"
# line:  docker compose logs dsh | grep 'dsh web'
# A bare http://localhost:3080 without the token returns 401 (expected).
# Comma-separated authorities (host:port) used to reach the WebUI.
# Required because the /api trust fence rejects unknown Host headers.
# Example: TRUSTED_HOSTS=192.168.1.10:3080,myserver:3080
TRUSTED_HOSTS=

# --- Remote configuration ---
# Since 0.1.2 upstream governs remote settings access via the trust model:
# TRUSTED_HOSTS + the per-launch token. The image still patches the remaining
# client-side loopback pin at build time, so Settings works from trusted
# authorities. The old DSH_ALLOW_REMOTE_CONFIGURATION flag no longer exists.
# WARNING: anyone who can reach the WebUI (and holds the token) can read and
# change settings and credentials — put an authenticating reverse proxy in
# front when exposing it beyond your own network.

# --- Telemetry ---
# Image default is 1 (telemetry disabled). Set to an empty value to enable
# upstream telemetry.
#DSH_TELEMETRY_DISABLED=1

# --- GitHub ---
# Token for gh/git (https://github.com/settings/tokens; scopes: repo, read:org,
# workflow). Bootstrap source for a one-time login whose state then persists on
# the dsh-home volume:
#   docker compose exec dsh sh -c 'printenv GH_TOKEN | gh auth login --with-token'
# Note: dsh scrubs TOKEN-named env vars from agent shells by design, so the
# stored gh login (not this variable) is what agents authenticate with.
GH_TOKEN=

# Git identity for commits (git reads these variables automatically;
# alternatively `git config --global` once — ~/.gitconfig persists on dsh-home).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# --- Build (only relevant for `docker compose build` / `up --build`) ---
# Upstream git tag to build dsh from, e.g. dsh-v0.1.2-alpha.3
# (empty = Dockerfile default). dsh is built from source: expect ~15-30 min
# and >=6 GB RAM for the builder stage.
DSH_VERSION=
# Pin the GitHub CLI version (empty = Dockerfile default)
GH_VERSION=
# Pin the Playwright version for browser tooling (empty = Dockerfile default)
PLAYWRIGHT_VERSION=
# Pin the uv version (empty = Dockerfile default)
UV_VERSION=
